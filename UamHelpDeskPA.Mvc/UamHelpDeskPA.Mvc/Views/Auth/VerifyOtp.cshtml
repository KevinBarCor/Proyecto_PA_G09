@model UamHelpDeskPA.Mvc.Models.VerifyOtpViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Verificar OTP</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>

<body class="bg-light">

    <div class="container d-flex justify-content-center align-items-center"
         style="height:100vh;">

        <div class="card shadow p-4"
             style="width:380px;">

            <h3 class="text-center mb-4">
                Verificar Código
            </h3>

            <form asp-action="VerifyOtp"
                  method="post">

                <div class="mb-3">
                    <label class="form-label">
                        Código OTP
                    </label>

                    <input asp-for="Code"
                           class="form-control"
                           maxlength="6" />

                    <span asp-validation-for="Code"
                          class="text-danger"></span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        Código OTP inválido.
                    </div>
                }

                <button type="submit"
                        class="btn btn-primary w-100">
                    Verificar
                </button>

            </form>

        </div>

    </div>

</body>
</html>