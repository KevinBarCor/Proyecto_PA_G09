@model List<UamHelpDeskPA.Mvc.Models.MySessionViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Mis sesiones</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body class="bg-light">

    <div class="container mt-5">

        <h2 class="mb-4">Sesiones activas</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <div class="card shadow">

            <div class="card-body">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Token</th>
                            <th>Creado</th>
                            <th>Expira</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var session in Model)
                        {
                            <tr>
                                <td style="max-width:200px; word-break:break-all;">
                                    @session.Token
                                </td>

                                <td>@session.CreatedAtUtc.ToLocalTime()</td>
                                <td>@session.ExpiresAtUtc.ToLocalTime()</td>

                                <td class="d-flex gap-2">

                                    <form asp-action="RevokeSession" method="post">
                                        <input type="hidden" name="refreshTokenId" value="@session.Id" />
                                        <button class="btn btn-sm btn-danger">
                                            Revocar
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

                <div class="d-flex justify-content-end mt-3">

                    <form asp-action="RevokeAllSessions" method="post">
                        <button class="btn btn-warning">
                            Cerrar todas las sesiones
                        </button>
                    </form>

                </div>

            </div>

        </div>

        <div class="mt-3 text-center">
            <a asp-action="Index" asp-controller="Home">Volver</a>
        </div>

    </div>

</body>
</html>