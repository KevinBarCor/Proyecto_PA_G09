@{
    ViewData["Title"] = "Usuarios";
}

<div class="content-wrapper">

    <section class="content-header">

        <div class="container-fluid">

            <div class="row mb-2">

                <div class="col-sm-6">

                    <h1>
                        <i class="fas fa-users"></i>
                        Usuarios
                    </h1>

                </div>

                <div class="col-sm-6 text-right">

                    <button type="button"
                            class="btn btn-primary"
                            id="btnNuevoUsuario">

                        <i class="fas fa-plus"></i>
                        Nuevo Usuario

                    </button>

                </div>

            </div>

        </div>

    </section>

    <section class="content">

        <div class="container-fluid">

            <div class="card">

                <div class="card-header">

                    <h3 class="card-title">

                        Listado de Usuarios

                    </h3>

                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table id="tablaUsuarios"
                               class="table table-bordered table-hover">

                            <thead>

                                <tr>

                                    <th>ID</th>

                                    <th>Nombre</th>

                                    <th>Apellido</th>

                                    <th>Correo</th>

                                    <th>Rol</th>

                                    <th>Estado</th>

                                    <th style="width:180px">
                                        Acciones
                                    </th>

                                </tr>

                            </thead>

                            <tbody>
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

<!-- MODAL CREAR / EDITAR -->

<div class="modal fade"
     id="modalUsuario"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-primary">

                <h5 class="modal-title"
                    id="tituloModal">

                    Nuevo Usuario

                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal">

                    <span>&times;</span>

                </button>

            </div>

            <div class="modal-body">

<input type="hidden"
       id="txtId" />
                <div class="form-group">

                    <label>
                        Nombre
                    </label>

                    <input type="text"
                           class="form-control"
                           id="txtFirstName"
                           maxlength="100" />

                </div>

                <div class="form-group">

                    <label>
                        Apellido
                    </label>

                    <input type="text"
                           class="form-control"
                           id="txtLastName"
                           maxlength="100" />

                </div>

                <div class="form-group">

                    <label>
                        Correo Electrónico
                    </label>

                    <input type="email"
                           class="form-control"
                           id="txtEmail"
                           maxlength="200" />

                </div>

                <div class="form-group">

                    <label>
                        Contraseña
                    </label>

                    <input type="password"
                           class="form-control"
                           id="txtPassword"
                           maxlength="100" />

                </div>

                <div class="form-group">

                    <label>
                        Rol
                    </label>

                    <select class="form-control"
                            id="ddlRoles">

                        <option value="">
                            Seleccione un rol
                        </option>

                    </select>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">

                    Cancelar

                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnGuardar">

                    Guardar

                </button>

            </div>

        </div>

    </div>

</div>

<!-- MODAL DETALLE -->

<div class="modal fade"
     id="modalDetalle"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-info">

                <h5 class="modal-title">

                    Detalle del Usuario

                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal">

                    <span>&times;</span>

                </button>

            </div>

            <div class="modal-body">

                <p>
                    <strong>Nombre:</strong>
                    <span id="detalleNombre"></span>
                </p>

                <p>
                    <strong>Apellido:</strong>
                    <span id="detalleApellido"></span>
                </p>

                <p>
                    <strong>Email:</strong>
                    <span id="detalleEmail"></span>
                </p>

                <p>
                    <strong>Rol:</strong>
                    <span id="detalleRol"></span>
                </p>

                <p>
                    <strong>Estado:</strong>
                    <span id="detalleEstado"></span>
                </p>

            </div>
                        <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">

                    Cerrar

                </button>

            </div>

        </div>

    </div>

</div>

<!-- MODAL ELIMINAR -->

<div class="modal fade"
     id="modalEliminar"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-danger">

                <h5 class="modal-title">

                    Eliminar Usuario

                </h5>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="txtEliminarId" />

                <p>

                    ¿Desea eliminar este usuario?

                </p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">

                    Cancelar

                </button>

                <button type="button"
                        class="btn btn-danger"
                        id="btnConfirmarEliminar">

                    Eliminar

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
<script>

let usuarioEditando = false;

const endpoints = {

    get: '/Users/GetUsers',

    getById: (id) =>
        `/Users/GetUserById?id=${id}`,

    create: '/Users/CreateUser',

    update: (id) =>
        `/Users/UpdateUser?id=${id}`,

    delete: (id) =>
        `/Users/DeleteUser?id=${id}`,

    roles: '/Users/GetRoles'
};

$(document).ready(function () {

    cargarUsuarios();

    cargarRoles();

});

function cargarUsuarios() {

    $.ajax({

        url: endpoints.get,

        type: 'GET',

        success: function (data) {

            renderTabla(data);

        },

        error: function () {

            toastr.error(
                'Error cargando usuarios'
            );

        }

    });

}

function cargarRoles() {

    $.ajax({

        url: endpoints.roles,

        type: 'GET',

        success: function (roles) {

            const ddl =
                $('#ddlRoles');

            ddl.empty();

            ddl.append(`
                <option value="">
                    Seleccione un rol
                </option>
            `);

            $.each(
                roles,
                function (i, role) {

                    ddl.append(`
                        <option value="${role.id}">
                            ${role.name}
                        </option>
                    `);

                });

        }

    });

}
function renderTabla(usuarios) {

const tbody =
$('#tablaUsuarios tbody');

tbody.empty();

if (!usuarios ||
usuarios.length === 0) {

tbody.append(`
<tr>
<td colspan="7"
class="text-center">

No existen usuarios

</td>
</tr>
`);

return;
}

$.each(
usuarios,
function (index, user) {

tbody.append(`

<tr>

<td>${user.id}</td>

<td>${user.firstName}</td>

<td>${user.lastName}</td>

<td>${user.email}</td>

<td>${user.roleName}</td>

<td>

${user.isActive
? '<span class="badge badge-success">Activo</span>'
: '<span class="badge badge-danger">Inactivo</span>'
}

</td>

<td>

<button
class="btn btn-info btn-sm btnDetalle"
data-id="${user.id}">

<i class="fas fa-eye"></i>

</button>

<button
class="btn btn-warning btn-sm btnEditar"
data-id="${user.id}">

<i class="fas fa-edit"></i>

</button>

<button
class="btn btn-danger btn-sm btnEliminar"
data-id="${user.id}">

<i class="fas fa-trash"></i>

</button>

</td>

</tr>

`);

});

}

$('#btnNuevoUsuario').click(function () {

usuarioEditando = false;

$('#txtId').val('');

$('#txtFirstName').val('');

$('#txtLastName').val('');

$('#txtEmail').val('');

$('#txtPassword').val('');

$('#ddlRoles').val('');

$('#tituloModal').text(
'Nuevo Usuario'
);

$('#modalUsuario').modal('show');

});

$(document).on(
'click',
'.btnDetalle',
function () {

const id =
$(this).data('id');

$.ajax({

url:
endpoints.getById(id),

type: 'GET',

success: function (res) {

const user =
res.result ?? res;

$('#detalleNombre')
.text(user.firstName);

$('#detalleApellido')
.text(user.lastName);

$('#detalleEmail')
.text(user.email);

$('#detalleRol')
.text(user.roleName);

$('#detalleEstado')
.text(
user.isActive
? 'Activo'
: 'Inactivo'
);

$('#modalDetalle')
.modal('show');

}

});

});

        $(document).on(
            'click',
            '.btnEditar',
            function () {

                const id = $(this).data('id');

                $.ajax({

                    url: endpoints.getById(id),

                    type: 'GET',

                    success: function (res) {


                        if (typeof res === "string") {
                            res = JSON.parse(res);
                        }

                        const user = res.result;

                        usuarioEditando = true;

                        $('#txtId').val(user.id);

                        console.log("ID guardado:", $('#txtId').val());

                        $('#txtFirstName').val(user.firstName);
                        $('#txtLastName').val(user.lastName);
                        $('#txtEmail').val(user.email);
                        $('#ddlRoles').val(user.roleId);
                        $('#txtPassword').val('');

                        $('#tituloModal').text('Editar Usuario');

                        $('#modalUsuario').modal('show');
                    }

                });

            });
        $(document).on(
            'click',
            '.btnEliminar',
            function () {

                const id =
                    $(this).data('id');

                $('#txtEliminarId')
                    .val(id);

                $('#modalEliminar')
                    .modal('show');

            });

        $('#btnGuardar').click(function () {

            const dto = {

                roleId:
                    parseInt(
                        $('#ddlRoles').val()
                    ),

                firstName:
                    $('#txtFirstName')
                        .val(),

                lastName:
                    $('#txtLastName')
                        .val(),

                email:
                    $('#txtEmail')
                        .val(),

                password:
                    $('#txtPassword')
                        .val()

            };

            if (!dto.firstName ||
                !dto.lastName ||
                !dto.email ||
                !dto.roleId) {

                toastr.warning(
                    'Complete todos los campos obligatorios'
                );

                return;
            }

            if (!usuarioEditando) {

                $.ajax({

                    url:
                        endpoints.create,

                    type:
                        'POST',

                    contentType:
                        'application/json',

                    data:
                        JSON.stringify(dto),

                    success: function () {

                        toastr.success(
                            'Usuario creado correctamente'
                        );

                        $('#modalUsuario')
                            .modal('hide');

                        cargarUsuarios();

                    },

                    error: function (xhr) {

                        toastr.error(
                            xhr.responseText ||
                            'Error creando usuario'
                        );

                    }

                });

            }
            else {

                const id =
                    $('#txtId').val();
            console.log("ID que se enviará al Update:", id);

            console.log("DTO:", dto);
                $.ajax({

                    url:
                        endpoints.update(id),

                    type:
                        'PUT',

                    contentType:
                        'application/json',

                    data:
                        JSON.stringify(dto),

                    success: function () {

                        toastr.success(
                            'Usuario actualizado correctamente'
                        );

                        $('#modalUsuario')
                            .modal('hide');

                        cargarUsuarios();

                    },

                    error: function (xhr) {

                        toastr.error(
                            xhr.responseText ||
                            'Error actualizando usuario'
                        );

                    }

                });

            }

        });

        $('#btnConfirmarEliminar')
        .click(function () {

            const id =
                $('#txtEliminarId')
                    .val();

            $.ajax({

                url:
                    endpoints.delete(id),

                type:
                    'DELETE',

                success: function () {

                    toastr.success(
                        'Usuario eliminado correctamente'
                    );

                    $('#modalEliminar')
                        .modal('hide');

                    cargarUsuarios();

                },

                error: function (xhr) {

                    toastr.error(
                        xhr.responseText ||
                        'Error eliminando usuario'
                    );

                }

            });

        });

    </script>

}