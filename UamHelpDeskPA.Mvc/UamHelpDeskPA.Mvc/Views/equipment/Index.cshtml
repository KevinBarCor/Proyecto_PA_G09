@{
    ViewData["Title"] = "Mantenimiento de Equipos";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h4 class="mb-0"
        style="color:#1a73e8;font-weight:700;">

        <i class="fas fa-desktop mr-2"></i>

        Mantenimiento de Equipos

    </h4>

    <button type="button"
            class="btn btn-nuevo"
            id="btnNuevo">

        <i class="fas fa-plus mr-1"></i>

        Nuevo Equipo

    </button>

</div>
<div class="card card-mantenimiento">

    <div class="card-header d-flex align-items-center">

        <h3 class="card-title mb-0">

            <i class="fas fa-list mr-2"></i>

            Listado

            <span class="badge-count ml-2"
                  id="totalEquipos">

                0

            </span>

        </h3>

    </div>

    <div class="card-body p-0">
        <div id="loadingSpinner"
             class="text-center">

            <div class="spinner-border text-primary"
                 role="status">

                <span class="sr-only">
                    Cargando...
                </span>

            </div>

            <p class="mt-2 text-muted small">
                Cargando equipos...
            </p>

        </div>
        <div class="table-responsive"
             id="tablaWrapper"
             style="display:none;">

            <table class="table table-hover mb-0"
                   id="tablaEquipos">

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Código</th>

                        <th>Laboratorio</th>

                        <th>Marca</th>

                        <th>Modelo</th>

                        <th>Tipo</th>

                        <th>Estado</th>

                        <th class="text-center"
                            style="width:120px;">

                            Acciones

                        </th>

                    </tr>

                </thead>

                <tbody></tbody>

            </table>

        </div>
    </div>

</div>
<!-- Modal Crear/Editar -->

<div class="modal fade"
     id="modalEquipo"
     tabindex="-1"
     role="dialog">

    <div class="modal-dialog modal-lg"
         role="document">

        <div class="modal-content">

            <div class="modal-header modal-header-primary">

                <h5 class="modal-title">
                    <i class="fas fa-desktop mr-2"></i>
                    <span id="modalTitulo">
                        Nuevo Equipo
                    </span>
                </h5>

                <button type="button"
                        class="close text-white"
                        data-dismiss="modal">

                    <span>&times;</span>

                </button>

            </div>

            <div class="modal-body px-4 py-4">

                <input type="hidden"
                       id="idInput" />

                <div class="form-group">

                    <label class="font-weight-600">
                        Laboratorio
                    </label>

                    <select id="laboratoryIdInput"
                            class="form-control">
                    </select>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label class="font-weight-600">
                                Código
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="codeInput" />

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label class="font-weight-600">
                                Marca
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="brandInput" />

                        </div>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label class="font-weight-600">
                                Modelo
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="modelInput" />

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label class="font-weight-600">
                                Número de Serie
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="serialNumberInput" />

                        </div>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label class="font-weight-600">
                                Tipo
                            </label>

                            <select id="typeInput" class="form-control">

                                <option value="0">Desktop</option>
                                <option value="1">Laptop</option>
                                <option value="2">Printer</option>
                                <option value="3">Projector</option>
                                <option value="4">Other</option>

                            </select>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label class="font-weight-600">
                                Estado
                            </label>

                            <select id="statusInput" class="form-control">

                                <option value="0">
                                    Operational
                                </option>

                                <option value="1">
                                    UnderRepair
                                </option>

                                <option value="2">
                                    Decommissioned
                                </option>

                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="font-weight-600">
                        Fecha de Compra
                    </label>
                    <input type="date"
                           class="form-control"
                           id="purchaseDateInput" />
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">
                    Cancelar
                </button>
                <button type="button"
                        class="btn btn-primary"
                        id="btnGuardar">
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Eliminar -->

<div class="modal fade"
     id="modalConfirmar"
     tabindex="-1"
     role="dialog">

    <div class="modal-dialog modal-sm"
         role="document">

        <div class="modal-content">

            <div class="modal-header modal-header-danger">

                <h5 class="modal-title">

                    <i class="fas fa-exclamation-triangle mr-2"></i>

                    Confirmar

                </h5>

                <button type="button"
                        class="close text-white"
                        data-dismiss="modal">

                    <span>&times;</span>

                </button>

            </div>

            <div class="modal-body text-center py-4">

                <i class="fas fa-trash-alt icono-advertencia mb-3 d-block"></i>

                <p class="font-weight-bold mb-1">

                    ¿Eliminar equipo?

                </p>

                <p class="text-muted small"
                   id="mensajeEliminar">

                    Esta acción no se puede deshacer.

                </p>

            </div>

            <div class="modal-footer justify-content-center bg-light">

                <button type="button"
                        class="btn btn-secondary btn-sm"
                        data-dismiss="modal">

                    Cancelar

                </button>

                <button type="button"
                        class="btn btn-danger btn-sm"
                        id="btnConfirmarEliminar">

                    Sí, eliminar

                </button>

            </div>

        </div>

    </div>

</div>
<!-- Modal Detalle -->

<div class="modal fade"
     id="modalDetalle"
     tabindex="-1"
     role="dialog">

    <div class="modal-dialog modal-lg"
         role="document">

        <div class="modal-content">

            <div class="modal-header modal-header-primary">

                <h5 class="modal-title">

                    Detalle del Equipo

                </h5>

                <button type="button"
                        class="close text-white"
                        data-dismiss="modal">

                    <span>&times;</span>

                </button>

            </div>

            <div class="modal-body">

                <p><strong>Código:</strong> <span id="detalleCode"></span></p>

                <p><strong>Laboratorio:</strong> <span id="detalleLaboratorio"></span></p>

                <p><strong>Marca:</strong> <span id="detalleBrand"></span></p>

                <p><strong>Modelo:</strong> <span id="detalleModel"></span></p>

                <p><strong>Serie:</strong> <span id="detalleSerial"></span></p>

                <p><strong>Tipo:</strong> <span id="detalleType"></span></p>

                <p><strong>Estado:</strong> <span id="detalleStatus"></span></p>

                <p><strong>Fecha Compra:</strong> <span id="detallePurchaseDate"></span></p>

            </div>

        </div>

    </div>

</div>
@section Scripts {
<script>
    (function () {
        const endpoints = {
            get: '/Equipment/GetEquipment',
            labs: '/Equipment/GetLaboratories',
            create: '/Equipment/CreateEquipment',
            update: (id) => `/Equipment/UpdateEquipment?id=${id}`,
            delete: (id) => `/Equipment/DeleteEquipment?id=${id}`,
            getById: (id) => `/Equipment/GetEquipmentById?id=${id}`
        };

        let equipos = [];
        let laboratorios = [];
        let idPendienteEliminar = null;

                function cargarLaboratorios() {

            $.ajax({
                url: endpoints.labs,
                type: 'GET',

                success: function (data) {

                    laboratorios = data;

                    const ddl = $('#laboratoryIdInput');

                    ddl.empty();

                    $.each(laboratorios, function (i, l) {

                        ddl.append(`
                            <option value="${l.id}">
                                ${l.name}
                            </option>
                        `);

                    });
                },
                error: function () {

                    $('#laboratoryIdInput').empty();

                }
            });
        }
                function cargarEquipos() {

            $('#loadingSpinner').show();
            $('#tablaWrapper').hide();

            $.ajax({

                url: endpoints.get,
                type: 'GET',

                success: function (data) {

                    equipos = data;

                    renderTabla();

                    $('#loadingSpinner').hide();
                    $('#tablaWrapper').show();
                },

                error: function () {

                    $('#loadingSpinner').hide();

                    alert(
                        'No fue posible cargar los equipos.'
                    );
                }
            });
        }
                function renderTabla() {

            const tbody =
                $('#tablaEquipos tbody');

            tbody.empty();

            if (!equipos || equipos.length === 0) {

                tbody.append(`
                    <tr>
                        <td colspan="8"
                            class="text-center text-muted py-4">

                            <i class="fas fa-inbox fa-2x d-block mb-2"></i>

                            No hay equipos registrados.

                        </td>
                    </tr>
                `);

                $('#totalEquipos').text('0');

                return;
            }

            $.each(equipos, function (i, e) {

                tbody.append(`
                    <tr>

                        <td>${e.id}</td>
                        <td>${e.code}</td>
                        <td>${e.laboratoryName}</td>
                        <td>${e.brand}</td>
                        <td>${e.model}</td>
                        <td>${e.type}</td>
                        <td>${e.status}</td>
                        <td class="text-center">

                            <button
                                class="btn btn-accion btn-outline-primary mr-1 btn-editar"
                                data-id="${e.id}">

                                <i class="fas fa-edit"></i>
                            </button>
                                                <button
                                class="btn btn-accion btn-outline-info mr-1 btn-detalle"
                                data-id="${e.id}">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button
                                class="btn btn-accion btn-outline-danger btn-eliminar"
                                data-id="${e.id}">

                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `);
            });

            $('#totalEquipos')
                .text(equipos.length);
        }
                function limpiarFormulario() {

            $('#idInput').val('');

            $('#laboratoryIdInput').val('');

            $('#codeInput').val('');
            $('#brandInput').val('');
            $('#modelInput').val('');
            $('#serialNumberInput').val('');

            $('#typeInput').val('Desktop');

            $('#statusInput').val('Operational');

            $('#purchaseDateInput').val('');

            $('#modalTitulo')
                .text('Nuevo Equipo');
        }
                function editar(id) {

            const equipo =
                equipos.find(x => x.id === id);

            if (!equipo)
                return;

            $('#idInput').val(equipo.id);

            $('#laboratoryIdInput')
                .val(equipo.laboratoryId);

            $('#codeInput')
                .val(equipo.code);

            $('#brandInput')
                .val(equipo.brand);

            $('#modelInput')
                .val(equipo.model);

            $('#serialNumberInput')
                .val(equipo.serialNumber);

            $('#typeInput')
                .val(equipo.type);

            $('#statusInput')
                .val(equipo.status);

            if (equipo.purchaseDate) {

                const fecha =
                    equipo.purchaseDate.substring(0, 10);

                $('#purchaseDateInput')
                    .val(fecha);
            }

            $('#modalTitulo')
                .text('Editar Equipo');

            $('#modalEquipo').modal('show');
        }
                function confirmarEliminar(id) {

            idPendienteEliminar = id;

            const equipo =
                equipos.find(x => x.id === id);

            if (equipo) {

                $('#mensajeEliminar').text(
                    `Se eliminará el equipo "${equipo.code}".`
                );
            }

            $('#modalConfirmar').modal('show');
        }
        async function guardar() {

            try {

                const id = $('#idInput').val();

                const dto = {

                    laboratoryId: parseInt($('#laboratoryIdInput').val()),
                    code: $('#codeInput').val(),
                    brand: $('#brandInput').val(),
                    model: $('#modelInput').val(),
                    serialNumber: $('#serialNumberInput').val(),
                    type: parseInt($('#typeInput').val()),
                    status: parseInt($('#statusInput').val()),
                    purchaseDate: $('#purchaseDateInput').val() || null
                };

                console.log('DTO ENVIADO:', dto);

                const response = await fetch(
                    id
                        ? endpoints.update(id)
                        : endpoints.create,
                    {
                        method: id ? 'PUT' : 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(dto)
                    });

                console.log('STATUS HTTP:', response.status);

                const texto = await response.text();

                console.log('RESPUESTA COMPLETA:', texto);

                if (!response.ok) {

                    alert(texto);

                    return;
                }

                $('#modalEquipo').modal('hide');

                cargarEquipos();
            }
            catch (error) {

                console.error('ERROR:', error);

                alert(error);
            }
        }
                async function eliminar() {

            if (idPendienteEliminar === null)
                return;

            $('#modalConfirmar').modal('hide');

            const response =
                await fetch(
                    endpoints.delete(
                        idPendienteEliminar
                    ),
                    {
                        method: 'DELETE'
                    });

            if (!response.ok) {

                alert(
                    'No fue posible eliminar.'
                );

                return;
            }

            cargarEquipos();
        }
                function detalle(id) {

            const equipo =
                equipos.find(x => x.id === id);

            if (!equipo)
                return;

            $('#detalleCode').text(equipo.code);

            $('#detalleLaboratorio')
                .text(equipo.laboratoryName);

            $('#detalleBrand')
                .text(equipo.brand);

            $('#detalleModel')
                .text(equipo.model);

            $('#detalleSerial')
                .text(equipo.serialNumber);

            $('#detalleType')
                .text(equipo.type);

            $('#detalleStatus')
                .text(equipo.status);

            $('#detallePurchaseDate')
                .text(
                    equipo.purchaseDate
                        ? equipo.purchaseDate.substring(0, 10)
                        : ''
                );

            $('#modalDetalle').modal('show');
        }
                    $(document).ready(function () {

                cargarLaboratorios();

                cargarEquipos();

                $('#btnNuevo').on(
                    'click',
                    function () {

                        limpiarFormulario();

                        $('#modalEquipo')
                            .modal('show');
                    });

                $(document).on(
                    'click',
                    '.btn-editar',
                    function () {

                        editar(
                            parseInt(
                                $(this).data('id')
                            )
                        );
                    });

                $(document).on(
                    'click',
                    '.btn-eliminar',
                    function () {

                        confirmarEliminar(
                            parseInt(
                                $(this).data('id')
                            )
                        );
                    });
                        $(document).on('click','.btn-detalle',
                    function () {
                     detalle(
                    parseInt(
                    $(this).data('id')
                            )
                        );
                    });
                $('#btnGuardar')
                    .on('click', guardar);

                $('#btnConfirmarEliminar')
                    .on('click', eliminar);

            });

        })();


    </script>

}